# ============================================================================
# Grafana Cloud Configuration for PgCache Endurance Benchmark
# Copy this file to .env.grafana and fill in your token.
# ============================================================================

export GRAFANA_STACK_URL="https://pgcachebench.grafana.net"
export CLUSTER_NAME="pgcache-doks"

# Grafana Cloud API Token (metrics:write, logs:write, fleet-management:read)
export GCLOUD_RW_API_KEY="glc_REPLACE_WITH_YOUR_GRAFANA_CLOUD_TOKEN"

# Prometheus Remote Write Endpoint & Instance Username
export GCLOUD_PROM_URL="https://prometheus-prod-67-prod-us-west-0.grafana.net/api/prom/push"
export GCLOUD_PROM_USER="3686863"

# Loki Logs Write Endpoint & Instance Username
export GCLOUD_LOKI_URL="https://logs-prod-021.grafana.net/loki/api/v1/push"
export GCLOUD_LOKI_USER="1839096"

# Fleet Management Endpoint & Stack ID
export GCLOUD_FM_URL="https://fleet-management-prod-014.grafana.net"
export GCLOUD_FM_USER="1881320"
