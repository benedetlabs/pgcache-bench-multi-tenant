{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "1. Benchmark Timeline & Application Experience (pgbench Live Telemetry)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "semi-dark-gray", "index": 0, "text": "0: Idle" },
                "1": { "color": "red", "index": 1, "text": "1: Origin Read (30m)" },
                "2": { "color": "yellow", "index": 2, "text": "2: PgCache Read Warm-up" },
                "3": { "color": "green", "index": 3, "text": "3: PgCache Read (30m)" },
                "4": { "color": "orange", "index": 4, "text": "4: Origin Read+Write (15m)" },
                "5": { "color": "yellow", "index": 5, "text": "5: PgCache R/W Warm-up" },
                "6": { "color": "blue", "index": 6, "text": "6: PgCache Read+Write (15m)" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "semi-dark-gray", "value": null },
              { "color": "red", "value": 1 },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 },
              { "color": "orange", "value": 4 },
              { "color": "yellow", "value": 5 },
              { "color": "blue", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "always",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Benchmark Phase Timeline (Origin Direct vs PgCache Proxy)",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_phase_id{cluster=\"$cluster\"})",
          "legendFormat": "Active Benchmark Phase",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Client Throughput — Live TPS (Transactions / Sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_live_tps{cluster=\"$cluster\"}) and max(pgbench_target_is_pgcache{cluster=\"$cluster\"}) == 0",
          "legendFormat": "Origin Direct (Path A) TPS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_live_tps{cluster=\"$cluster\"}) and max(pgbench_target_is_pgcache{cluster=\"$cluster\"}) == 1",
          "legendFormat": "PgCache Proxy (Path B) TPS",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Client Transaction Latency — Average & Stddev (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_live_latency_ms{cluster=\"$cluster\"}) and max(pgbench_target_is_pgcache{cluster=\"$cluster\"}) == 0",
          "legendFormat": "Origin Direct Avg Latency (ms)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_live_latency_ms{cluster=\"$cluster\"}) and max(pgbench_target_is_pgcache{cluster=\"$cluster\"}) == 1",
          "legendFormat": "PgCache Proxy Avg Latency (ms)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgbench_live_latency_stddev_ms{cluster=\"$cluster\"})",
          "legendFormat": "Latency Stddev (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 200,
      "panels": [],
      "title": "2. Hardware Resource Offload — CPU, Memory, Disk I/O & Network (Origin vs PgCache)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Node CPU Utilization (%) — Origin vs PgCache vs Loadgen",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 - (avg by (bench_role) (rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{bench_role}} CPU %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 35, "lineWidth": 1, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Node CPU Breakdown (%) — User, System, I/O Wait, SoftIRQ",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{cluster=\"$cluster\", bench_role=\"origin\", mode=~\"user|system|iowait|softirq|steal\"}[1m])) * 100",
          "legendFormat": "origin: {{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Memory Usage (GiB) — Origin vs PgCache Node & Cache Store",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "node_memory_MemTotal_bytes{cluster=\"$cluster\", bench_role=~\"origin|pgcache\"} - node_memory_MemAvailable_bytes{cluster=\"$cluster\", bench_role=~\"origin|pgcache\"}",
          "legendFormat": "{{bench_role}} Node Used RAM",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgcache_cache_memory_used_bytes{cluster=\"$cluster\"})",
          "legendFormat": "PgCache Internal Memory Used",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(pgcache_cache_memory_budget_bytes{cluster=\"$cluster\"})",
          "legendFormat": "PgCache Memory Budget (MEMORY_LIMIT)",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "iops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Disk IOPS (Reads/s vs Writes/s on Block Storage)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(node_disk_reads_completed_total{cluster=\"$cluster\", bench_role=\"origin\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "Origin Disk Read IOPS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(node_disk_writes_completed_total{cluster=\"$cluster\", bench_role=\"origin\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "Origin Disk Write IOPS",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Disk Throughput (Read vs Write Bytes/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(node_disk_read_bytes_total{cluster=\"$cluster\", bench_role=\"origin\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "Origin Disk Read (B/s)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(node_disk_written_bytes_total{cluster=\"$cluster\", bench_role=\"origin\", device!~\"loop.*|ram.*\"}[1m]))",
          "legendFormat": "Origin Disk Write (B/s)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Network Bandwidth (Rx / Tx Bytes/s per Node Role)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (bench_role) (rate(node_network_receive_bytes_total{cluster=\"$cluster\", device!~\"lo|veth.*|cali.*|cilium.*\"}[1m]))",
          "legendFormat": "{{bench_role}} Rx",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (bench_role) (rate(node_network_transmit_bytes_total{cluster=\"$cluster\", device!~\"lo|veth.*|cali.*|cilium.*\"}[1m]))",
          "legendFormat": "{{bench_role}} Tx",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 300,
      "panels": [],
      "title": "3. Origin PostgreSQL Internal Database Metrics (postgres-exporter)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Active Connections by State (pg_stat_activity)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (backend_state) (pg_activity_states_connections{cluster=\"$cluster\"})",
          "legendFormat": "{{backend_state}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "pg_stat_database_numbackends{cluster=\"$cluster\", datname=\"bench\"}",
          "legendFormat": "total backends (bench)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 32 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Tuples Scanned & Fetched / Sec",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_tup_returned{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "tup_returned / sec (scanned)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_tup_fetched{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "tup_fetched / sec (index)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Buffer Hits vs Disk Block Reads / Sec",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_blks_read{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "blks_read / s (Disk / OS Read)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_blks_hit{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "blks_hit / s (shared_buffers)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Origin Commits & Row Mutations / Sec",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_xact_commit{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "xact_commit / s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_tup_updated{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "tup_updated / s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pg_stat_database_tup_inserted{cluster=\"$cluster\", datname=\"bench\"}[1m])",
          "legendFormat": "tup_inserted / s",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 400,
      "panels": [],
      "title": "4. PgCache Proxy, Materialized Views & CDC Replication Telemetry (:9091/metrics)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["mean", "min", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "PgCache Hit Ratio (%) & Effective MV Hit Ratio (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * rate(pgcache_queries_cache_hit{cluster=\"$cluster\"}[1m]) / clamp_min(rate(pgcache_queries_cache_hit{cluster=\"$cluster\"}[1m]) + rate(pgcache_queries_cache_miss{cluster=\"$cluster\"}[1m]), 0.001)",
          "legendFormat": "Total Cache Hit Ratio %",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * clamp_min(rate(pgcache_queries_cache_hit{cluster=\"$cluster\"}[1m]) - rate(pgcache_cache_mv_fallthrough{cluster=\"$cluster\"}[1m]), 0) / clamp_min(rate(pgcache_queries_cache_hit{cluster=\"$cluster\"}[1m]) + rate(pgcache_queries_cache_miss{cluster=\"$cluster\"}[1m]), 0.001)",
          "legendFormat": "Effective MV/Memo Hit Ratio %",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "id": 15,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "PgCache Query Execution Rate (Cache Hits, MV Hits, Misses, Errors / s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(pgcache_queries_cache_hit{cluster=\"$cluster\"}[1m])",
          "legendFormat": "cache_hit / s",
